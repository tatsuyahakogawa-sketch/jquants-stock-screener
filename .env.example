# J-Quants API V2 のAPIキー（ダッシュボードの「設定 > APIキー」から発行）
# .env にコピーして実際の値を入れる。.env はコミットしないこと
JQUANTS_API_KEY=your-api-key

# EDINET API のSubscription-Key（https://api.edinet-fsa.go.jp/api/auth/index.aspx?mode=1 で無料登録・電話番号必須）
# 事業概要・大株主・潜在株式の状況の自動取得に使う
EDINET_API_KEY=your-edinet-api-key

# Supabase（任意設定）。J-Quantsキャッシュ(data/cache/)をSupabaseにも保存し、
# Streamlit Cloudの再デプロイでローカルキャッシュが消えても再利用できるようにする。
# 未設定でもアプリは動く（ローカルキャッシュのみになる）。設定手順はREADME.md参照。
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key
