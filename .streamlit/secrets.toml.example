# Streamlit Community Cloudにデプロイする場合、この内容を
# アプリの管理画面「Settings > Secrets」に貼り付けて設定する。
# ローカル実行のみなら不要（.streamlit/secrets.toml自体を作らなければ
# パスワード認証はスキップされる）。
#
# ローカルで試す場合はこのファイルを .streamlit/secrets.toml にコピーする
# （.streamlit/secrets.toml はコミットしないこと。.gitignore で除外済み）。

app_password = "your-password-here"
JQUANTS_API_KEY = "your-jquants-api-key"
EDINET_API_KEY = "your-edinet-api-key"
